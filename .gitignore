# ============================================================================
#  仓库根目录的保护规则（新增，不改动题包原文）
#
#  为什么需要这个文件：
#    题包提供两个 .gitignore，分别在 "Basic Task/" 和 "Advanced Task/" 里。
#    git 的规则是：.gitignore 只对【它所在目录及其子目录】生效。
#    所以仓库根目录没有任何保护 —— 放在根目录的模型文件或 .env 会被提交。
#
#  本文件只补根目录缺失的部分，不重复题包已有的规则。
#  两个题包的 .gitignore 保持原样，不做任何修改。
# ============================================================================

# ── 模型权重与推理引擎（放根目录时的保护）──────────────────────────────────
/models/
/llama.cpp/
*.gguf
*.safetensors
*.pt
*.pth
*.ckpt

# ── 密钥与本地配置（⚠️ 最重要的一条）────────────────────────────────────
.env
.env.*
!.env.example

# ── 临时辅助区（笔记、草稿、一次性脚本）──────────────────────────────────
/_work/

# ── Python 运行痕迹 ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 构建产物 ────────────────────────────────────────────────────────────
build/
dist/
target/
*.o
*.obj
*.so

# ── KV 快照与运行时临时文件 ─────────────────────────────────────────────
kv_cache/
*.kv
*.tmp
.cache/
.runtime/

# ── 编辑器与系统文件 ────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
